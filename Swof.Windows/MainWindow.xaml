<Window x:Class="Swof.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Swof.Windows"
        mc:Ignorable="d"
        Title="SWOF Engine MVP" Height="720" Width="1100"
        Background="#111111"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <DockPanel LastChildFill="True">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Margin="14,10"
                   Foreground="#F2F2F2"
                   FontFamily="Consolas"
                   FontSize="16"
                   Text="Arrows move. Space action. R restarts after out of play." />
        <local:FieldView x:Name="Field" Focusable="False" />
    </DockPanel>
</Window>
